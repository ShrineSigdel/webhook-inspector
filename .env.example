# =============================================================================
# Docker Compose environment
# =============================================================================
# Run docker compose from this directory (the repository root), not backend/.
# Copy this file to .env before starting the stack:
#   cp .env.example .env
#
# Then edit the values below. Generate secrets with:
#   openssl rand -hex 32
#
# Running the backend directly on your machine instead? Use
# backend/.env.example, because it uses localhost instead of db/redis.

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# Postgres user created on the first start.
POSTGRES_USER=hooks

# Strong password for that user. Change this before deploying.
POSTGRES_PASSWORD=change-me

# Database created on the first start.
POSTGRES_DB=hooks

# Connection string used by the api and worker containers.
# It must match POSTGRES_USER, POSTGRES_PASSWORD and POSTGRES_DB above.
# Keep the hostname `db`: that is the Compose service name.
DATABASE_URL=postgres://hooks:change-me@db:5432/hooks

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------

# Redis address inside Compose. Keep the hostname `redis`.
REDIS_URL=redis://redis:6379

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------

# Secret used to sign access tokens. At least 32 characters.
# Generate with: openssl rand -hex 32
# 32 random bytes, represented as 64 hexadecimal characters.
JWT_SECRET=replace-with-64-hex-characters

# -----------------------------------------------------------------------------
# App and network
# -----------------------------------------------------------------------------

# Port the API listens on inside its container.
# Keep 3000: Nginx and the API healthcheck use api:3000.
PORT=3000

# Public URL used to build hook links. Use the address people will open.
# Local:  http://localhost
# VM:     http://SERVER_IP   (replace SERVER_IP with your server's public IP)
PUBLIC_URL=http://localhost

# Send refresh cookies only over HTTPS. Keep false for local HTTP and the
# plain-HTTP Level 1 VM. Set true only after HTTPS is configured.
COOKIE_SECURE=false
