# For running the backend on the host: npm run dev and npm test.
# The Docker Compose stack uses ../.env.example instead (hostnames db/redis).
# HOST-SIDE ONLY: do not run `docker compose` from this directory. Compose
# would load this file and the containers would try localhost instead of db/redis.
# Copy this file to .env and fill in the values.
DATABASE_URL=postgres://hooks:dev@localhost:5432/hooks
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-64-hex-characters
PORT=3000
PUBLIC_URL=http://localhost:5173
COOKIE_SECURE=false